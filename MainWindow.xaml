<Window x:Class="UtiliTech.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:UtiliTech.Views"
        Title="UtiliTech" Icon="Assets/utilitech.ico" Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

  <!-- Barra de título própria (como o ResetExplode): o Windows continua cuidando de arrastar, encaixar e redimensionar -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="{DynamicResource BgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barra de título -->
    <DockPanel Grid.ColumnSpan="2" Background="{DynamicResource TitleBrush}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="ThemeBtn" Style="{StaticResource TitleBtn}" Content="&#xE706;" FontSize="14" ToolTip="Tema claro/escuro"
                Click="Theme_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Minimizar"
                Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="MaxBtn" Style="{StaticResource TitleBtn}" Content="&#xE922;" ToolTip="Maximizar"
                Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Style="{StaticResource TitleCloseBtn}" Content="&#xE8BB;" ToolTip="Fechar"
                Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Image Source="{StaticResource LogoMark}" Width="20" Height="20" VerticalAlignment="Center"/>
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13">
          <Run Text="UTILI" FontWeight="Bold"/><Run Text="TECH" FontWeight="Light"/>
        </TextBlock>
        <TextBlock x:Name="PageTitle" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
    </DockPanel>

    <!-- Menu lateral em painel arredondado -->
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,14">
          <!-- Versão e situação da atualização; com versão nova, um clique abre Configurações -->
          <Border x:Name="VersionCard" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="12" Padding="12,9" Margin="0,0,0,10" MouseLeftButtonUp="VersionCard_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Text="VERSÃO" Style="{StaticResource Caption}" Margin="0,0,14,4"/>
              <TextBlock x:Name="VersionValue" Grid.Column="1" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="1" Text="UPDATE" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
              <TextBlock x:Name="UpdateValue" Grid.Row="1" Grid.Column="1" Text="verificando" FontFamily="{StaticResource NumberFont}"
                         FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
          <TextBlock x:Name="MachineText" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"/>
          <TextBlock x:Name="AdminText" Style="{StaticResource Muted}" FontSize="11" Margin="4,1,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel>
            <RadioButton x:Name="NavOverview" GroupName="Nav" Style="{StaticResource NavItem}" Content="Visão geral" Tag="overview"
                         v:NavIcon.Glyph="&#xE80F;" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavAttendance" GroupName="Nav" Style="{StaticResource NavItem}" Content="Atendimentos" Tag="attendance"
                         v:NavIcon.Glyph="&#xE81C;" Checked="Nav_Checked"/>

            <ToggleButton x:Name="DiagGroup" Style="{StaticResource NavGroup}" Content="DIAGNÓSTICO"/>
            <StackPanel x:Name="DiagItems"
                        Visibility="{Binding IsChecked, ElementName=DiagGroup, Converter={StaticResource BoolToVisibility}}">
              <RadioButton x:Name="NavSystem" GroupName="Nav" Style="{StaticResource NavItem}" Content="Sistema" Tag="system" v:NavIcon.Glyph="&#xE770;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Monitor" Tag="monitor" v:NavIcon.Glyph="&#xE9D9;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Discos (S.M.A.R.T.)" Tag="disks" v:NavIcon.Glyph="&#xEDA2;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Bateria" Tag="battery" v:NavIcon.Glyph="&#xE83F;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Memória RAM" Tag="memory" v:NavIcon.Glyph="&#xE964;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Teste de estresse" Tag="stress" v:NavIcon.Glyph="&#xE945;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Rede" Tag="network" v:NavIcon.Glyph="&#xE839;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Segurança" Tag="security" v:NavIcon.Glyph="&#xE72E;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Alertas" Tag="alerts" v:NavIcon.Glyph="&#xEA8F;" Checked="Nav_Checked"/>
            </StackPanel>

            <ToggleButton x:Name="PosGroup" Style="{StaticResource NavGroup}" Content="PÓS-FORMATAÇÃO"/>
            <StackPanel x:Name="PosItems"
                        Visibility="{Binding IsChecked, ElementName=PosGroup, Converter={StaticResource BoolToVisibility}}">
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Checklist" Tag="checklist" v:NavIcon.Glyph="&#xE9D5;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Instalar apps" Tag="install" v:NavIcon.Glyph="&#xE896;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Inicialização" Tag="startup" v:NavIcon.Glyph="&#xE7E8;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Nome e domínio" Tag="domain" v:NavIcon.Glyph="&#xE968;" Checked="Nav_Checked"/>
            </StackPanel>

            <ToggleButton x:Name="ManGroup" Style="{StaticResource NavGroup}" Content="MANUTENÇÃO"/>
            <StackPanel x:Name="ManItems"
                        Visibility="{Binding IsChecked, ElementName=ManGroup, Converter={StaticResource BoolToVisibility}}">
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Reparos rápidos" Tag="repairs" v:NavIcon.Glyph="&#xE90F;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Limpeza" Tag="cleanup" v:NavIcon.Glyph="&#xE74D;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Usuários e perfis" Tag="profiles" v:NavIcon.Glyph="&#xE716;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Drivers" Tag="drivers" v:NavIcon.Glyph="&#xEEA1;" Checked="Nav_Checked"/>
              <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="Impressoras" Tag="printers" v:NavIcon.Glyph="&#xE749;" Checked="Nav_Checked"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="18,10,18,6"/>
            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}" Content="Configurações" Tag="settings"
                         v:NavIcon.Glyph="&#xE713;" Checked="Nav_Checked"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Host" Grid.Row="1" Grid.Column="1" Margin="20,16,12,8"/>
  </Grid>
</Window>
