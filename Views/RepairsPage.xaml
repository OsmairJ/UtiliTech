<UserControl x:Class="UtiliTech.Views.RepairsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <DockPanel Margin="0,0,0,18">
        <CheckBox x:Name="SimulationBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                  ToolTip="Mostra no registro os comandos e arquivos que seriam mexidos, sem executar nada">
          <TextBlock Text="Modo simulação (não altera nada)" Margin="6,0,0,0"/>
        </CheckBox>
        <StackPanel>
          <TextBlock Text="Reparos rápidos" Style="{StaticResource H1}"/>
          <TextBlock x:Name="Status" Style="{StaticResource Muted}" Text="Correções comuns do dia a dia, com 1 clique. Tudo fica no registro abaixo."/>
        </StackPanel>
      </DockPanel>

      <ItemsControl x:Name="RepairList" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
              <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                  <Button DockPanel.Dock="Right" Content="Executar" Style="{StaticResource Btn}" Padding="14,6" Click="Run_Click"
                          IsEnabled="{Binding DataContext.CanRun, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                  <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                             TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,10,0"/>
                </DockPanel>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Registro" Style="{StaticResource H2}"/>
          <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="180"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
