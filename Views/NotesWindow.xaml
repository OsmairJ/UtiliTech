<Window x:Class="UtiliTech.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="620" SizeToContent="Height" FontFamily="Segoe UI" FontSize="13">
  <Border Margin="14" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          MouseLeftButtonDown="Body_MouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.5"/>
    </Border.Effect>
    <StackPanel Margin="22,20,22,18">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <Image Source="{StaticResource LogoMark}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
      <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="SectionList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2,8,2">
                        <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="2,0,8,0"/>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Content="Fechar" Style="{StaticResource Btn}" HorizontalAlignment="Right" Margin="0,8,0,0" IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
  </Border>
</Window>
