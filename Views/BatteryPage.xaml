<UserControl x:Class="UtiliTech.Views.BatteryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Atualizar" Style="{StaticResource BtnGhost}" Click="Refresh_Click" Margin="0,0,8,0"/>
          <Button x:Name="PowercfgBtn" Content="Relatório completo (powercfg)" Style="{StaticResource Btn}" Click="Powercfg_Click"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Bateria" Style="{StaticResource H1}"/>
          <TextBlock x:Name="Status" Style="{StaticResource Muted}" Text="Carregando..."/>
        </StackPanel>
      </DockPanel>

      <Border x:Name="NoBattery" Style="{StaticResource Card}" Visibility="Collapsed">
        <TextBlock Text="Nenhuma bateria encontrada. Este computador parece ser um PC de mesa." Style="{StaticResource Muted}"/>
      </Border>

      <Border x:Name="BatteryCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Border x:Name="VerdictBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}">
              <TextBlock x:Name="VerdictText" Foreground="White" FontWeight="SemiBold"/>
            </Border>
            <StackPanel>
              <TextBlock Text="Saúde da bateria" Style="{StaticResource Muted}"/>
              <TextBlock x:Name="HealthText" FontSize="34" FontWeight="SemiBold"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="HealthBar" Maximum="100" Height="10" Margin="0,0,0,14"/>
          <ItemsControl x:Name="BatteryItems" ItemTemplate="{StaticResource InfoRow}"/>
          <TextBlock x:Name="ReasonsText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
