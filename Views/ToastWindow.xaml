<Window x:Class="UtiliTech.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="360" SizeToContent="Height" FontFamily="Segoe UI" FontSize="13">
  <Border Margin="10" CornerRadius="10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Cursor="Hand" MouseLeftButtonUp="Body_Click">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="Bar" CornerRadius="10,0,0,10"/>
      <DockPanel Grid.Column="1" Margin="14,12,10,14">
        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource BtnGhost}" Padding="7,1" VerticalAlignment="Top" Click="Close_Click"/>
        <StackPanel Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource LogoMark}" Width="16" Height="16" Margin="0,0,7,0"/>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
