<UserControl x:Class="UtiliTech.Views.ChecklistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <DockPanel Margin="0,0,0,18">
        <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="Verificar de novo" Style="{StaticResource Btn}"
                VerticalAlignment="Center" Click="Refresh_Click"/>
        <StackPanel>
          <TextBlock Text="Checklist de pós-formatação" Style="{StaticResource H1}"/>
          <TextBlock x:Name="Status" Style="{StaticResource Muted}" Text="Verificando o PC..."/>
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
            <StackPanel>
              <TextBlock x:Name="SummaryTitle" Text="Pronto para entregar?" Style="{StaticResource H2}" Margin="0"/>
              <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="Progress" Height="8" Maximum="1"/>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="StepList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="10" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Foreground="{Binding Color}"
                           VerticalAlignment="Center" Width="28" Margin="0,0,12,0"/>
                <Button DockPanel.Dock="Right" Content="{Binding Action}" Tag="{Binding Page}" Style="{StaticResource BtnGhost}" Padding="12,6"
                        VerticalAlignment="Center" Margin="12,0,0,0" Click="Go_Click"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource PanelBrush}" Margin="12,0,0,0">
                  <TextBlock Text="{Binding StateText}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
