<Window x:Class="UtiliTech.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Width="620" SizeToContent="Height" FontFamily="Segoe UI" FontSize="13"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
  <Border Margin="14" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.5"/>
    </Border.Effect>
    <StackPanel Margin="14">
      <Grid>
        <TextBox x:Name="QueryBox" Style="{StaticResource Input}" FontSize="15" Padding="38,10,10,10" VerticalContentAlignment="Center"
                 TextChanged="Query_TextChanged"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0"
                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
        <TextBlock x:Name="Hint" Text="Buscar ferramenta: tela azul, bitlocker, impressora, gpupdate..." Foreground="{DynamicResource MutedBrush}"
                   FontSize="15" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <ListBox x:Name="ResultList" Margin="0,10,0,0" MaxHeight="420" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="Result_Click" KeyboardNavigation.TabNavigation="None">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Text="Nada encontrado. Tente outra palavra (ex.: rede, disco, driver)." Style="{StaticResource Muted}"
                 Margin="10,12,0,4" Visibility="Collapsed"/>
      <TextBlock Text="↑ ↓ escolher · Enter abrir · Esc fechar" Style="{StaticResource Muted}" FontSize="11" Margin="10,8,0,0"/>
    </StackPanel>
  </Border>
</Window>
