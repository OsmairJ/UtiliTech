<UserControl x:Class="UtiliTech.Views.PrintersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource BtnGhost}" VerticalAlignment="Center" Click="Refresh_Click"/>
        <StackPanel>
          <TextBlock Text="Impressoras" Style="{StaticResource H1}"/>
          <TextBlock x:Name="Status" Style="{StaticResource Muted}" Text="Lendo as impressoras..."/>
        </StackPanel>
      </DockPanel>

      <!-- Impressoras instaladas -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Instaladas neste PC" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="Nada sai em nenhuma impressora? Use Reparos → Destravar fila de impressão. &quot;Cópia 1&quot; costuma ser fila fantasma de driver instalado duas vezes: teste e remova a que não imprime."/>
          <ItemsControl x:Name="PrinterList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="8" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="460" HorizontalAlignment="Right">
                      <Button Content="Página de teste" Tag="test" Style="{StaticResource BtnGhost}" Padding="10,5" Margin="0,2,6,2" Click="Action_Click"/>
                      <Button Content="Padrão" Tag="default" Style="{StaticResource BtnGhost}" Padding="10,5" Margin="0,2,6,2" Click="Action_Click"
                              Visibility="{Binding CanSetDefault, Converter={StaticResource BoolToVisibility}}"/>
                      <Button Content="Limpar fila" Tag="clear" Style="{StaticResource BtnGhost}" Padding="10,5" Margin="0,2,6,2" Click="Action_Click"
                              Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}"/>
                      <Button Content="Abrir fila" Tag="queue" Style="{StaticResource BtnGhost}" Padding="10,5" Margin="0,2,6,2" Click="Action_Click"/>
                      <Button Content="Remover" Tag="remove" Style="{StaticResource BtnGhost}" Padding="10,5" Margin="0,2,0,2" Click="Action_Click"/>
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Badges}" Foreground="{Binding BadgeColor}" FontSize="11" FontWeight="Bold" Margin="10,2,0,0"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Reach}" Foreground="{Binding ReachColor}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Lexmark do pendrive -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Lexmark do pendrive" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="Abre o assistente da Lexmark: ele procura as impressoras na rede (escolha pelo IP ou nome de host), instala com o driver indicado e já cria a impressora. Depois da primeira vez, o driver também aparece em Instalar pelo IP, para as próximas do mesmo modelo."/>
          <ItemsControl x:Name="LexmarkList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Content="Abrir instalador" Style="{StaticResource Btn}" Padding="12,6" Click="Lexmark_Click"
                          IsEnabled="{Binding Available}" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold">
                      <Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" · driver " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding DriverType, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Procurar na rede (sem Lexmark) -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CancelScanBtn" Content="Parar" Style="{StaticResource BtnGhost}" Click="CancelScan_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Button x:Name="ScanBtn" Content="Procurar na rede" Style="{StaticResource Btn}" Click="Scan_Click"/>
            </StackPanel>
            <TextBlock Text="Procurar impressoras na rede (exceto Lexmark)" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="ScanStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="Testa a porta de impressão (9100) em toda a rede da placa conectada e pergunta o modelo a cada impressora (SNMP, só leitura). Leva uns 10 segundos e não muda nada nas impressoras. As Lexmark ficam de fora: use Lexmark do pendrive."/>
          <ItemsControl x:Name="FoundList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Usar para instalar" Style="{StaticResource BtnGhost}" Padding="12,6"
                            VerticalAlignment="Center" Margin="12,0,0,0" Click="UseFound_Click"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding DriverText}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Instalar por IP -->
      <Border x:Name="InstallCard" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Instalar impressora de rede pelo IP" Style="{StaticResource H2}"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="IP da impressora" Style="{StaticResource Label}"/>
              <TextBox x:Name="IpBox" Style="{StaticResource Input}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Nome (como vai aparecer no Windows)" Style="{StaticResource Label}"/>
              <TextBox x:Name="NameBox" Style="{StaticResource Input}"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Driver" Style="{StaticResource Label}"/>
          <ComboBox x:Name="DriverBox" Margin="0,0,0,6" Padding="8,6"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Testar IP pergunta o modelo à impressora e já escolhe o driver. Brother e Samsung: Microsoft PCL6 Class Driver (vem no Windows). Lexmark MX620/CS725: o driver aparece aqui depois do assistente do pendrive. Outro fabricante: instale o driver antes (Drivers → pasta) ou use o Microsoft IPP Class Driver."/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PingBtn" Content="Testar IP e achar driver" Style="{StaticResource BtnGhost}" Click="PingIp_Click" Margin="0,0,8,0"/>
            <Button x:Name="InstallBtn" Content="Instalar" Style="{StaticResource Btn}" Click="Install_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Compartilhada -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Conectar impressora compartilhada" Style="{StaticResource H2}"/>
          <DockPanel>
            <Button x:Name="ConnectBtn" DockPanel.Dock="Right" Content="Conectar" Style="{StaticResource Btn}" Click="Connect_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="ShareBox" Style="{StaticResource Input}" VerticalContentAlignment="Center"
                     ToolTip="Ex.: \\servidor\impressora-andar1"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Formato \\servidor\impressora. O Windows baixa o driver do servidor."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Registro" Style="{StaticResource H2}"/>
          <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="150"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
