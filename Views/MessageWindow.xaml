<Window x:Class="UtiliTech.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="460" SizeToContent="Height" FontFamily="Segoe UI" FontSize="13">
  <Border Margin="14" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          MouseLeftButtonDown="Body_MouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.5"/>
    </Border.Effect>
    <StackPanel Margin="22,20,22,20">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
      </StackPanel>

      <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="19"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="CancelBtn" Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" IsCancel="True"
                Click="Cancel_Click" Visibility="Collapsed"/>
        <Button x:Name="OkBtn" Content="OK" Style="{StaticResource Btn}" IsDefault="True" MinWidth="80" Click="Ok_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
