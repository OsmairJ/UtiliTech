<UserControl x:Class="UtiliTech.Views.DisksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource BtnGhost}" Click="Refresh_Click" VerticalAlignment="Center"/>
        <StackPanel>
          <TextBlock Text="Discos (S.M.A.R.T.)" Style="{StaticResource H1}"/>
          <TextBlock x:Name="Status" Style="{StaticResource Muted}" Text="Carregando..."/>
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="PredictText" Style="{StaticResource Muted}" Margin="0,0,0,12"/>

      <ItemsControl x:Name="DiskList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding VerdictColor}">
                    <TextBlock Text="{Binding Verdict}" Foreground="White" FontWeight="SemiBold"/>
                  </Border>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource InfoRow}"/>
                <TextBlock Text="{Binding ReasonsText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Unidades" Style="{StaticResource H2}"/>
          <ItemsControl x:Name="VolumeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding BarColor}" Maximum="100" Margin="0,6,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
