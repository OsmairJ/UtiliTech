<UserControl x:Class="UtiliTech.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="Configurações" Style="{StaticResource H1}"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
      </StackPanel>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Aparência" Style="{StaticResource H2}"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="DarkBtn" Content="Escuro" Click="Dark_Click" Margin="0,0,8,0" Padding="18,8"/>
            <Button x:Name="LightBtn" Content="Claro" Click="Light_Click" Padding="18,8"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" Text="A troca vale na hora e fica salva para as próximas vezes."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Atualizações" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                     Text="O UtiliTech confere a última versão publicada no GitHub Releases. Informe o repositório no formato usuário/nome."/>
          <DockPanel Margin="0,0,0,10">
            <Button x:Name="CheckBtn" DockPanel.Dock="Right" Content="Verificar agora" Style="{StaticResource Btn}" Click="Check_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="RepoBox" Style="{StaticResource Input}" VerticalContentAlignment="Center" LostFocus="Repo_LostFocus"/>
          </DockPanel>
          <CheckBox x:Name="AutoCheckBox" Content="Procurar atualização ao abrir o app" Click="AutoCheck_Click" Margin="0,0,0,10"/>
          <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateNotes" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="Collapsed"/>
          <StackPanel x:Name="InstallPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
            <Button x:Name="InstallBtn" Content="Baixar e instalar" Style="{StaticResource Btn}" Click="Install_Click"/>
            <ProgressBar x:Name="DownloadBar" Width="260" Maximum="100" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Segurança" Style="{StaticResource H2}"/>
          <CheckBox x:Name="RestorePointBox" Click="RestorePoint_Click">
            <StackPanel Margin="6,0,0,0">
              <TextBlock Text="Criar ponto de restauração antes de mexer no PC" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                         Text="Vem marcado na confirmação de resetar rede, resetar Windows Update e instalar drivers. Dá para desmarcar na hora."/>
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>

      <Border x:Name="ShortcutsCard" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Atalhos de teclado" Style="{StaticResource H2}"/>
          <ItemsControl x:Name="ShortcutList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3">
                  <Border DockPanel.Dock="Left" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                          Background="{DynamicResource PanelBrush}" Padding="8,2" MinWidth="70" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource NumberFont}" FontSize="12" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Registro de erros" Style="{StaticResource H2}"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                     Text="Quando algo dá errado no app, os detalhes ficam guardados aqui (últimos 10 dias). Útil para descobrir o que aconteceu num PC do cliente."/>
          <TextBlock x:Name="LogInfo" Margin="0,0,0,10" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Abrir pasta de registros" Style="{StaticResource BtnGhost}" Click="OpenLogs_Click" Margin="0,0,8,0"/>
            <Button Content="Abrir registro de hoje" Style="{StaticResource BtnGhost}" Click="OpenToday_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Sobre" Style="{StaticResource H2}"/>
          <TextBlock x:Name="AboutText" Style="{StaticResource Muted}"/>
          <Button Content="Ver novidades" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Notes_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
