<Window x:Class="UtiliTech.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="480" SizeToContent="Height" FontFamily="Segoe UI" FontSize="13">
  <Border Margin="14" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          MouseLeftButtonDown="Body_MouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.5"/>
    </Border.Effect>
    <StackPanel Margin="22,20,22,20">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
      </StackPanel>

      <TextBlock Text="O que vai acontecer" Style="{StaticResource Label}" Margin="0,0,0,6"/>
      <ItemsControl x:Name="EffectList" Margin="0,0,0,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,5">
              <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="2,0,8,0"/>
              <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border x:Name="WarningBox" CornerRadius="8" Padding="12,9" Margin="0,8,0,0" Background="{DynamicResource PanelBrush}"
              BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontWeight="SemiBold"/>
      </Border>

      <CheckBox x:Name="RestoreBox" Margin="0,14,0,0" Visibility="Collapsed">
        <StackPanel Margin="6,0,0,0">
          <TextBlock Text="Criar ponto de restauração antes" FontWeight="SemiBold"/>
          <TextBlock Text="Permite voltar o Windows como estava se algo der errado (leva até 1 minuto)." Style="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>
      </CheckBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="CancelBtn" Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Style="{StaticResource Btn}" IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
