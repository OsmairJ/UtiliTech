<UserControl x:Class="UtiliTech.Views.AttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="0,0,12,0">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Atualizar" Style="{StaticResource BtnGhost}" Click="Refresh_Click" Margin="0,0,8,0"/>
        <Button Content="Abrir pasta do histórico" Style="{StaticResource BtnGhost}" Click="OpenFolder_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Atendimentos" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Status" Style="{StaticResource Muted}"
                   Text="Cada relatório ou planilha exportado na tela Sistema fica guardado aqui, na pasta atendimentos do pendrive."/>
      </StackPanel>
    </DockPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBox x:Name="SearchBox" Style="{StaticResource Input}" VerticalContentAlignment="Center" Padding="34,8,10,8"
               TextChanged="Search_TextChanged" ToolTip="Cliente, OS, nº de série, nome do PC, modelo, técnico ou data (dd/mm/aaaa)"/>
      <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"
                 VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
      <TextBlock x:Name="SearchHint" Text="Buscar por cliente, OS, nº de série, nome do PC, modelo..." Foreground="{DynamicResource MutedBrush}"
                 Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>

    <Border x:Name="EmptyBox" DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="Collapsed">
      <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="18,14">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Label}" Tag="{Binding Path}" Style="{StaticResource Btn}" Padding="12,6" Margin="0,0,8,0"
                                Click="OpenFile_Click" ToolTip="{Binding Name}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Pasta" Tag="{Binding Folder}" Style="{StaticResource BtnGhost}" Padding="12,6" Click="OpenFile_Click"/>
                </StackPanel>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Muted}" FontSize="12" Margin="12,2,0,0"/>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Machine}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Windows}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  <TextBlock Text="{Binding Health}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Observacoes}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
