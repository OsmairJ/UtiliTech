<UserControl x:Class="UtiliTech.Views.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:UtiliTech.Views">
  <UserControl.Resources>
    <Style x:Key="TileTitle" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="TileDetail" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,10"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PauseBtn" Content="Pausar" Style="{StaticResource BtnGhost}" Click="Pause_Click" Margin="0,0,8,0"/>
          <Button Content="Zerar máximos" Style="{StaticResource BtnGhost}" Click="Reset_Click"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Monitor" Style="{StaticResource H1}"/>
          <TextBlock x:Name="Status" Style="{StaticResource Muted}" Text="Abrindo sensores..."/>
        </StackPanel>
      </DockPanel>

      <Border x:Name="DriverBanner" Style="{StaticResource Card}" BorderBrush="#F0B232" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="DriverBtn" DockPanel.Dock="Right" Content="Instalar driver PawnIO" Style="{StaticResource Btn}"
                  Click="InstallDriver_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <StackPanel>
            <TextBlock Text="Temperatura da CPU e da placa-mãe indisponível" FontWeight="SemiBold" Foreground="#F0B232"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="O UtiliTech carrega o driver PawnIO sozinho ao abrir e remove ao fechar, mas aqui não conseguiu (precisa abrir como administrador). Como alternativa, instale o PawnIO de forma permanente. GPU, RAM e discos aparecem sem ele."/>
            <TextBlock x:Name="DriverStateText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Margin="0,0,-12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Tile}">
          <StackPanel>
            <TextBlock x:Name="CpuTitle" Text="PROCESSADOR" Style="{StaticResource TileTitle}"/>
            <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource TileValue}"/>
            <TextBlock x:Name="CpuDetail" Text=" " Style="{StaticResource TileDetail}"/>
            <v:Sparkline x:Name="CpuSpark" Height="46"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Tile}">
          <StackPanel>
            <TextBlock x:Name="GpuTitle" Text="PLACA DE VÍDEO" Style="{StaticResource TileTitle}"/>
            <TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource TileValue}"/>
            <TextBlock x:Name="GpuDetail" Text=" " Style="{StaticResource TileDetail}"/>
            <v:Sparkline x:Name="GpuSpark" Height="46"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Tile}">
          <StackPanel>
            <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource TileTitle}"/>
            <TextBlock x:Name="RamValue" Text="—" Style="{StaticResource TileValue}"/>
            <TextBlock x:Name="RamDetail" Text=" " Style="{StaticResource TileDetail}"/>
            <v:Sparkline x:Name="RamSpark" Height="46"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource Tile}">
          <StackPanel>
            <TextBlock Text="DISCOS" Style="{StaticResource TileTitle}"/>
            <TextBlock x:Name="DiskValue" Text="—" Style="{StaticResource TileValue}"/>
            <TextBlock x:Name="DiskDetail" Text=" " Style="{StaticResource TileDetail}"/>
            <v:Sparkline x:Name="DiskSpark" Height="46"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,14"
                 Text="Temperatura: verde até 70 °C · amarelo até 85 °C · vermelho acima. Gráfico: uso no último minuto."/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Armazenamento" Style="{StaticResource H2}"/>
          <ItemsControl x:Name="PhysicalList" ItemTemplate="{StaticResource InfoRow}" Margin="0,0,0,10"/>
          <ItemsControl x:Name="VolumeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding BarColor}" Maximum="100" Margin="0,6,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="GroupList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="SENSOR" Style="{StaticResource TileTitle}"/>
                  <TextBlock Grid.Column="1" Text="AGORA" Style="{StaticResource TileTitle}" TextAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="MÁXIMO" Style="{StaticResource TileTitle}" TextAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Sensors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding ValueColor}" TextAlignment="Right" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding Max}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
